# LLM configuration for the RAG FAQ chatbot
# 1. Put your Groq API key below (keep the quotes)
# 2. Save the file
# 3. Restart the app:  .venv\Scripts\streamlit.exe run src/app.py
#
# Embeddings do NOT need an API key - they run locally on HuggingFace
# (sentence-transformers/all-MiniLM-L6-v2).
#
# Without a key the app still runs in "extractive mode" and quotes source text.

GROQ_API_KEY=""
# Verify a model is live before relying on it:
#   https://api.groq.com/openai/v1/models
GROQ_MODEL="openai/gpt-oss-120b"

# Optional: only used if you also want an OpenAI fallback
# OPENAI_API_KEY=""
# LLM_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------
# Embedding backend (optional - the default is what the demo uses)
# ------------------------------------------------------------------
# onnx  = onnxruntime, no PyTorch. Peak memory ~235 MB.
#         Required for free-tier hosts that cap RAM at 512 MB (Render free).
# torch = sentence-transformers/PyTorch. Peak memory ~680 MB. Numerically
#         identical output (cosine similarity 1.000000), just heavier.
# If onnxruntime fails to load, the app falls back to torch automatically.
EMBEDDER_BACKEND=onnx

# onnxruntime defaults to claiming every core; one is plenty for a single
# user and leaves more memory headroom in a small container.
EMBEDDER_THREADS=1

# ------------------------------------------------------------------
# Retrieval tuning (optional - the defaults below are what the demo uses)
# ------------------------------------------------------------------

# Chunks returned to the LLM.
TOP_K=4

# Relevance gate: if the best ranked chunk scores below this, the bot replies
# "I don't have that information in my sources" instead of guessing.
# Raise it if the bot answers unrelated questions; lower it if it refuses
# questions you know are covered.
MIN_SCORE=0.25

# How much the lexical re-rank can add on top of dense similarity.
LEXICAL_BONUS=0.35

# Small bonus for chunks whose page matches the scheme named in the question.
SCHEME_BOOST=0.12

# 0 = re-rank every chunk in the collection (recommended for this small corpus).
CANDIDATE_POOL=0
